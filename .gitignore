*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# SQLite & Databases
*.db
*.sqlite
*.sqlite3
prismguard.db
*.db-journal

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Node & Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
*.log
npm-debug.log*
yarn-debug.log*

# IDE & OS
.vscode/
