# SecureAI Guard (leave blank to use simulated screening)
GUARD_URL=https://secureai-guard-598609297408.europe-west4.run.app
GUARD_TOKEN=
GUARD_TIMEOUT_SECONDS=8.0
GUARD_MAX_RETRIES=2
GUARD_RESEARCH_BUDGET=120

# OpenAI-compatible provider (leave LLM_API_KEY blank to use simulated responses)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20.0

# Gateway authentication; each key uses key:ROLE:tenant_id
PRISMGUARD_AUTH_ENABLED=true
PRISMGUARD_API_KEYS=pg-admin-key-2026:ADMIN:prism-admin,pg-researcher-key-2026:RESEARCHER:tenant-research,pg-viewer-key-2026:VIEWER:tenant-default

ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173